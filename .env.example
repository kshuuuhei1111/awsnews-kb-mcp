# CDK デプロイ先
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=ap-northeast-1

# Slack 通知（任意。未設定なら SNS のメール通知のみになる）
# 実際の値はコードに書かず、SSM パラメータ or Secrets Manager に格納する。
# ここには「どのパラメータ名を使うか」のみを記録する。
SLACK_WEBHOOK_SSM_PARAM=/awsnews-kb-mcp/slack-webhook-url

# Cognito（Phase 3 で生成される値をローカル動作確認用に控える）
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET_SSM_PARAM=/awsnews-kb-mcp/cognito-client-secret

# AgentCore Gateway エンドポイント（Phase 3 で生成される値）
AGENTCORE_GATEWAY_URL=
